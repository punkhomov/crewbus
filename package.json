{
  "name": "crewbus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @crewbus/contracts build && pnpm --filter @crewbus/agent build",
    "build": "pnpm build:packages && pnpm --filter @crewbus/server build && pnpm --filter @crewbus/web build && node scripts/prepare-web.mjs",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && vitest run",
    "test:e2e": "playwright test",
    "dev:server": "pnpm build:packages && pnpm --filter @crewbus/server dev",
    "dev:web": "pnpm --filter @crewbus/web dev",
    "start": "pnpm --filter @crewbus/server start",
    "verify:ui": "node scripts/verify-ui-provenance.mjs",
    "test:docker": "node scripts/docker-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@earendil-works/pi-ai": "0.87.1"
  }
}
